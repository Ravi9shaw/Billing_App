# Saved by setup under ~/.cloth_shop_billing/.env, never committed with secrets.
# Operating-system environment variables take precedence. All optional values can stay blank.
COMPANY_NAME=Your Company
ADMIN_PASSWORD_HASH=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_GSTIN=
BANK_NAME=
BANK_ACCOUNT=
BANK_IFSC=
BANK_BRANCH=
# Receiving UPI address for invoice payment QR (not a bare phone/account number).
UPI_ID=
INVOICE_TERMS=Thank you for your business.
DEFAULT_TAX_MODE=exclusive
DEFAULT_GST_RATE=5
BILLING_HOST=0.0.0.0
BILLING_PORT=5000
# For a second desktop computer only: connect to the host; never share the SQLite file.
BILLING_SERVER_URL=
BILLING_COOKIE_SECURE=false
# BILLING_DATA_DIR=C:\Users\you\.cloth_shop_billing
# BILLING_DB_PATH=C:\Users\you\.cloth_shop_billing\cloth_shop.db
# BACKUP_DIR=D:\ShopBackups
BACKUP_KEEP=30
BACKUP_INTERVAL_SECONDS=60
WHATSAPP_PROVIDER=disabled
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_BILL_TEMPLATE=
WHATSAPP_LANGUAGE=en
# Override only for development provider verification; never send real credentials to a test service.
WHATSAPP_API_BASE=https://graph.facebook.com
